@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-card">
    <div class="auth-logo">
        <span class="logo-mark" style="width:34px;height:34px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="5" r="2.5" />
                <circle cx="5" cy="18" r="2.5" />
                <circle cx="19" cy="18" r="2.5" />
                <line x1="12" y1="7.5" x2="5" y2="15.5" />
                <line x1="12" y1="7.5" x2="19" y2="15.5" />
                <line x1="7.5" y1="18" x2="16.5" y2="18" />
            </svg>
        </span>
        <span class="logo-text">WeConnect</span>
    </div>

    <h1 class="auth-title">Forgot password?</h1>
    <div class="auth-sub">Nhập email công ty của bạn để nhận liên kết đặt lại mật khẩu.</div>

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
        <div class="field">
            <label for="fp-email">Work email</label>
            <input class="input" id="fp-email" name="email" type="email" placeholder="name@weconnect.vn" />
        </div>
        <button class="btn btn-primary btn-block" type="submit">Gửi liên kết đặt lại</button>
    </form>

    <a class="forgot-link" asp-controller="Auth" asp-action="Login">← Quay lại Đăng nhập</a>
</div>
