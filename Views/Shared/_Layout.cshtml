<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — WeConnect" : "WeConnect")</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="app" id="app">
        @* Thanh điều hướng bên trái *@
        <partial name="_Sidebar" />

        <div class="app-main">
            @* Thanh trên cùng (breadcrumb + chuông + avatar) *@
            <partial name="_Topbar" />

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    @* Các thành phần dùng chung trên mọi trang sau đăng nhập *@
    <partial name="_TaskModal" />
    <partial name="_CreateProjectModal" />

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
